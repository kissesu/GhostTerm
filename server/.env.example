# @file .env.example
# @description 进度模块本地开发环境变量样板。
#              拷贝为 .env，server 启动时 godotenv 自动加载（生产部署不读）。
# @author Atlas.oi
# @date 2026-04-29

# ─────── 必填（缺失即拒绝启动） ───────

# Postgres 连接串。本地默认匹配 docker-compose.yml
DATABASE_URL=postgres://postgres:devpass@localhost:5432/progress?sslmode=disable

# JWT 密钥（HMAC，至少 32 字节）。本地随便设；生产从 secrets 注入
JWT_ACCESS_SECRET=dev-access-secret-32-bytes-min!!
JWT_REFRESH_SECRET=dev-refresh-secret-32-bytes-min!

# ─────── 可选（不填用默认） ───────

# HTTP 监听
HTTP_ADDR=:8080

# JWT TTL（time.Duration 字面量）
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# bcrypt cost；OWASP 2024 推荐 ≥12（每加 1 翻倍 CPU；12 是业界主流安全/性能折中）
# 与 server/internal/config/config.go 默认值保持一致
BCRYPT_COST=12

# 文件落盘根目录 + 单文件上限
FILE_STORAGE_PATH=./data/files
FILE_MAX_SIZE_MB=100

# 速率限制（v2 安全审计 finding #7：防分布式 botnet 暴破登录端点）
# 登录单 IP 每分钟最多 N 次（误输 5 次冷静 60s，对 5 人自用足够宽松）
RATE_LIMIT_LOGIN_PER_MIN_PER_IP=5
# 登录单 username 每分钟最多 N 次（多 IP 联合撞同账号也封死）
RATE_LIMIT_LOGIN_PER_MIN_PER_USER=10
# refresh 单 IP 每分钟最多 N 次（access TTL 15min 时单用户每分钟 ~1 次刷新）
RATE_LIMIT_REFRESH_PER_MIN_PER_IP=30

# 受信反代白名单（CIDR 列表，逗号分隔；v2 安全审计 finding #10）
# 直连模式（IP:38080 + Tauri reqwest 转发）保持空 = audit IP 不可被任何调用方伪造
# Caddy 同主机反代模式：TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 非法 CIDR 在 server 启动时 fail-fast，绝不静默回退
TRUSTED_PROXIES=
