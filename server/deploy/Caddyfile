# @file Caddyfile
# @description GhostTerm Atlas 边界反代 - TLS 1.3 + HSTS + 安全头 (finding #21)
#
# 业务背景：
#   - 部署目标：西安铂金 4H8G / Ubuntu 24.04 / IP 103.236.85.144
#   - 38080 端口非标免备案；自签 IP 证书 (SAN=IP)，Tauri reqwest cert pinning 信任
#   - 反代到 progress-server (127.0.0.1:18080)，progress-server 仅监听 localhost
#   - JSON 日志 100MB 滚动 5 份，便于事后审计
#
# @author Atlas.oi
# @date 2026-05-08

{
    # 自动 HTTPS 关闭（自签 IP 证书，不走 Let's Encrypt ACME）
    auto_https off
    admin off  # 关闭 Caddy admin API（默认监听 :2019，不需要）
}

103.236.85.144:38080 {
    tls /etc/ghostterm/cert.pem /etc/ghostterm/key.pem {
        protocols tls1.3
        # cipher 由 tls1.3 隐含定（仅 TLS 1.3 cipher suite，无需手动指定）
    }

    header {
        # HSTS - 1 年强制 HTTPS（IP 直连场景效果有限但仍加，防中间人 HTTP 降级）
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # 防 MIME sniff
        X-Content-Type-Options nosniff
        # 防点击劫持
        X-Frame-Options DENY
        # 隐藏 referer
        Referrer-Policy no-referrer
        # 禁用浏览器粒度功能（Tauri 不需要 geo/mic/cam）
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # 移除 Server header 暴露 Caddy 版本
        -Server
    }

    # 反代到内部 progress-server（仅监听 127.0.0.1）
    reverse_proxy 127.0.0.1:18080 {
        # 把客户端真实 IP 透传给后端（progress-server TRUSTED_PROXIES=127.0.0.1/32 信任）
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    log {
        output file /var/log/caddy/ghostterm.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 90d
        }
        format json
    }
}
