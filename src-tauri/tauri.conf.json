{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostTerm",
  "version": "0.6.3",
  "identifier": "com.atlas.ghostterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostTerm",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#1a1b26",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://103.236.85.144:38080 wss://103.236.85.144:38080 ws://127.0.0.1:* https://github.com https://objects.githubusercontent.com https://esm.sh https://fonts.googleapis.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "name": "Text File",
        "description": "Text and markup files",
        "ext": ["txt", "md", "markdown", "mdx", "rst", "log",
                "adoc", "asciidoc", "org", "wiki",
                "csv", "tsv", "tex", "bib",
                "diff", "patch"]
      },
      {
        "name": "Source Code",
        "description": "Source code files",
        "ext": ["js", "ts", "jsx", "tsx", "mjs", "cjs", "mts", "cts",
                "vue", "svelte", "astro",
                "wxml", "wxss", "wxs", "axml", "acss",
                "pug", "jade", "ejs", "hbs", "handlebars", "mustache",
                "liquid", "njk", "twig", "erb",
                "rs", "py", "go", "java", "kt", "kts", "swift",
                "c", "cpp", "h", "hpp", "cs", "rb", "php", "lua", "r", "dart", "zig",
                "scala", "sc", "groovy", "gradle",
                "clj", "cljs", "cljc", "edn", "lisp", "el",
                "ex", "exs", "eex", "heex", "leex", "erl", "hrl",
                "hs", "lhs", "ml", "mli", "elm",
                "nim", "cr", "v", "tcl", "mm", "nu",
                "proto", "thrift", "avsc", "wat",
                "sql", "graphql", "gql", "prisma",
                "sol", "move", "cairo", "vy",
                "tf", "tfvars", "hcl", "nix",
                "ipynb",
                "cmd", "bat", "csh", "ksh", "nush"]
      },
      {
        "name": "Config File",
        "description": "Configuration and data files",
        "ext": ["json", "jsonc", "toml", "yaml", "yml", "xml", "ini",
                "sh", "bash", "zsh", "fish", "ps1",
                "css", "scss", "less", "html", "htm", "svg",
                "env", "conf", "cfg", "properties", "lock",
                "gitignore", "gitattributes", "dockerignore", "editorconfig",
                "gitconfig", "gitmodules", "bashrc", "zshrc", "vimrc", "inputrc",
                "npmrc", "yarnrc", "nvmrc", "eslintrc", "prettierrc", "babelrc", "stylelintrc",
                "cmake", "mk", "ninja",
                "gemspec", "podspec", "mod", "sum",
                "htaccess", "htpasswd", "webmanifest"]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGREE5OTcxNTdBRjNEREYKUldUZlBhOVhjWm5hdndORVFhUFMzR21LOU91TE5uaFIrSEY3UTkyaGdYcDc0b3RidjNZbTVaOEEK",
      "endpoints": [
        "https://github.com/kissesu/GhostTerm/releases/latest/download/latest.json"
      ]
    }
  }
}